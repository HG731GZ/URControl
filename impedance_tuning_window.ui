<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ImpedanceTuningWindow</class>
 <widget class="QDialog" name="ImpedanceTuningWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1000</width><height>790</height></rect></property>
  <property name="windowTitle"><string>单轴调参测试</string></property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item><widget class="QLabel" name="hintLabel"><property name="text"><string>从当前位置出发：当前位置 → 当前位置＋偏置 → 当前位置－偏置 → 当前位置。各段平滑起停，其余五轴保持起点。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QGroupBox" name="trajectoryGroup"><property name="title"><string>轨迹设置（角度使用 °，内部使用 rad）</string></property>
    <layout class="QGridLayout" name="trajectoryLayout">
     <item row="0" column="0"><widget class="QLabel" name="axisLabel"><property name="text"><string>目标轴</string></property></widget></item>
     <item row="0" column="1"><widget class="QComboBox" name="axisCombo">
      <item><property name="text"><string>J1</string></property></item><item><property name="text"><string>J2</string></property></item><item><property name="text"><string>J3</string></property></item><item><property name="text"><string>J4</string></property></item><item><property name="text"><string>J5</string></property></item><item><property name="text"><string>J6</string></property></item>
     </widget></item>
     <item row="0" column="2"><widget class="QLabel" name="speedLabel"><property name="text"><string>最大速度（°/s）</string></property></widget></item>
     <item row="0" column="3"><widget class="QDoubleSpinBox" name="speedSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.010</double></property><property name="maximum"><double>360.0</double></property><property name="value"><double>5.0</double></property></widget></item>
     <item row="0" column="4"><widget class="QLabel" name="offsetLabel"><property name="text"><string>角度偏置（°）</string></property></widget></item>
     <item row="0" column="5"><widget class="QDoubleSpinBox" name="offsetSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>-180.0</double></property><property name="maximum"><double>180.0</double></property><property name="value"><double>5.0</double></property></widget></item>
     <item row="1" column="0" colspan="6"><widget class="QLabel" name="currentLabel"><property name="text"><string>当前位置：等待新鲜机器人反馈</string></property></widget></item>
    </layout>
   </widget></item>
   <item><widget class="QGroupBox" name="parameterGroup"><property name="title"><string>目标轴阻抗参数（执行时应用，运行中锁定）</string></property>
    <layout class="QGridLayout" name="parameterLayout">
     <item row="0" column="0"><widget class="QLabel" name="stiffnessLabel"><property name="text"><string>刚度 K（N·m/rad）</string></property></widget></item>
     <item row="0" column="1"><widget class="QDoubleSpinBox" name="stiffnessSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>100000.0</double></property></widget></item>
     <item row="0" column="2"><widget class="QLabel" name="dampingLabel"><property name="text"><string>阻尼 D（N·m·s/rad）</string></property></widget></item>
     <item row="0" column="3"><widget class="QDoubleSpinBox" name="dampingSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>100000.0</double></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="torqueLabel"><property name="text"><string>最大指令力矩（N·m）</string></property></widget></item>
     <item row="1" column="1"><widget class="QDoubleSpinBox" name="torqueSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>1000.0</double></property></widget></item>
     <item row="1" column="2"><widget class="QLabel" name="slewLabel"><property name="text"><string>力矩变化率（N·m/s）</string></property></widget></item>
     <item row="1" column="3"><widget class="QDoubleSpinBox" name="slewSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>100000.0</double></property></widget></item>
     <item row="2" column="0"><widget class="QLabel" name="accelerationLabel"><property name="text"><string>参考加速度上限（°/s²）</string></property></widget></item>
     <item row="2" column="1"><widget class="QDoubleSpinBox" name="accelerationSpin"><property name="decimals"><number>3</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>3600.0</double></property></widget></item>
     <item row="2" column="2" colspan="2"><widget class="QLabel" name="guardLabel"><property name="text"><string>摩擦补偿固定为 0；跟踪误差、速度和力矩守卫保持有效。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
    </layout>
   </widget></item>
   <item><layout class="QHBoxLayout" name="buttonLayout">
    <item><widget class="QPushButton" name="generateButton"><property name="text"><string>生成</string></property></widget></item>
    <item><widget class="QPushButton" name="executeButton"><property name="text"><string>执行</string></property><property name="enabled"><bool>false</bool></property></widget></item>
    <item><widget class="QPushButton" name="stopButton"><property name="text"><string>停止</string></property><property name="enabled"><bool>false</bool></property></widget></item>
   </layout></item>
   <item><widget class="QLabel" name="trajectoryLabel"><property name="text"><string>设置目标轴、速度和偏置后，点击“生成”。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="statusLabel"><property name="text"><string>未执行</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QVBoxLayout" name="plotLayout"/></item>
   <item><widget class="QLabel" name="reportLabel"><property name="text"><string>执行结束后显示：均方根误差、最大绝对误差、末点误差（°）。</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property></widget></item>
  </layout>
 </widget>

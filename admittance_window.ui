             <string>施力开始</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pushButton_EventReleased">
            <property name="text">
             <string>完全松手</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pushButton_EventBuzzing">
            <property name="text">
             <string>听到嗡鸣</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pushButton_EventStop">
            <property name="text">
             <string>请求停止</string>
            </property>
            <property name="toolTip">

             <set>Qt::TextSelectableByMouse</set>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_OperatorEvents" stretch="0,0,0,0,0,1">
          <item>
           <widget class="QLabel" name="label_OperatorEventTitle">
